      "source_text_sha256": "e35f77249e447e8016f47491538a060777c75c0d8a7baf14986903188a07ca02",
      "target": "我想让国家更加安全。"
    },
    {
      "path_id": 819,
      "field": "_data/value/_text/1",
      "offset": 204,
      "span": 68,
      "source_object_sha256": "406eb1378c78e552ae129af5d6d488394dd5bdbeceb4f56958c237308ac1f418",
      "source_text_sha256": "caa3ee1e707dbc9d13bc51a162cc0af8d630225887915ba712788688234a02b5",
      "target": "我想成为最先进安保计划的先驱。"
    },
    {
      "path_id": 820,
      "field": "_data/value/_text/1",
      "offset": 204,
      "span": 36,
      "source_object_sha256": "6814cab5f7dd7f3f4ff3641b80b9f5d2bd034aad7be69b9db195969e4cf09316",
      "source_text_sha256": "cb6833e086eff9ed286f056891cdabf6393b8523bbce12349e9ca7872183cc45",
      "target": "性偏好与特殊癖好"
    },
    {
      "path_id": 821,
      "field": "_data/value/_text/1",
      "offset": 180,
      "span": 24,
      "source_object_sha256": "21390ec9f7e9cebccc24e298d2ea27284c53ce76a04c332c1e5781297cb582e6",
      "source_text_sha256": "9d7948c70e51e429bdce5235df4e404be79404b39a4571932fe3c5579d56efb0",
      "target": "性取向"
    },
    {
      "path_id": 822,
      "field": "_data/value/_text/1",
      "offset": 180,
      "span": 20,
      "source_object_sha256": "04e06bfa01080273ae20484afa6c0131e5bbe78bcac020fbcf1b2186c82ec09e",
      "source_text_sha256": "29921123d6f09ae7078a89a26c6c55826dd766fc1bf6f80254172be5f4d0933a",
      "target": "身高与体重"
    },
    {
      "path_id": 823,
      "field": "_data/value/_text/1",
      "offset": 196,
      "span": 28,
      "source_object_sha256": "f2a9bfe22683a0e4a154debc261ac386038498a8077d6292f076ed24d34ca187",
      "source_text_sha256": "e2bf82bb7e9c6ea288bbf7942d04b60d5e4d83e21c6c0c97bb7ac8f40dba0eea",
      "target": "我喜欢窥探他人。"
    },
    {
      "path_id": 824,
      "field": "_data/value/_text/1",
      "offset": 188,
      "span": 64,
      "source_object_sha256": "9543e8c22d26b8903f4bb9e457add989a256e5076211c6e490bf693afd4b16b0",
      "source_text_sha256": "f3815595a8dfc39d8b5d582100ecc55e93095583c19afb3721cce670cd12ad49",
      "target": "你说错了。我在测试中一直如实作答。"
    },
    {
      "path_id": 825,
      "field": "_data/value/_text/1",
      "offset": 196,
      "span": 40,
      "source_object_sha256": "0fe2bc5446055f4bf736e3e4ab821ff6474c5b9bdbd35a1815a5ab847e53332a",
      "source_text_sha256": "3f075054d43de7b0d15b290d35e1633349f3a28ea45050a2c08c88fd2419431c",
      "target": "凡事都有两面。"
    },
    {
      "path_id": 826,
      "field": "_data/value/_text/1",
      "offset": 188,
      "span": 48,
      "source_object_sha256": "04bb6c633f9c210a96cb98891b0ed8830ac9f690e8f25b4bcdcb9634d1eb6234",
      "source_text_sha256": "1432fc32eef9b8b530e266cec5292b9e1d25dde19c9435795dcbf4d886b78429",
      "target": "不公正的法律可以、也应该被违反。"
    },
    {
      "path_id": 827,
      "field": "_data/value/_text/1",
      "offset": 188,
      "span": 116,
      "source_object_sha256": "ed496282141572f142161d382cc370c7923592937e2ed8b9cc24398ff267c2fe",
      "source_text_sha256": "ea24e3f6be4d91fb8700b433319ea70974d29066529ab898662893fa9733aa05",
      "target": "我警告朋友，我也为奥威尔工作；如果继续这样，我就不得不向有关部门举报。"
    },
    {
      "path_id": 828,
      "field": "_data/value/_text/1",
      "offset": 188,
      "span": 48,
      "source_object_sha256": "f0d0170bee76b6df9bd7d13e85dce9dd2a63fdf126ea79cf6e5af5fdce2d7e1d",
      "source_text_sha256": "7b9977169dfd368249b0abd5d1422f2c3d49ef56c8ebd48f4d5b76fc6e19040b",
      "target": "我选得不好，请让我重做测试。"
    },
